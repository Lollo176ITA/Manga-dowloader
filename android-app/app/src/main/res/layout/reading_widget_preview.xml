<?xml version="1.0" encoding="utf-8"?>
<!-- Anteprima nel selettore dei widget (Android 12+): solo viste supportate da RemoteViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/reading_widget_preview_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/reading_widget_preview_title"
            android:textColor="#FF1B1B1F"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/reading_widget_preview_subtitle"
            android:textColor="#FF45464F"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_widget_play"
        android:tint="#FF00696E" />
</LinearLayout>
